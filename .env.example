# Copy to ".env" and edit. Real environment variables override these.

# Sub-folder the app is served from (leading slash, no trailing slash).
# Leave empty / commented when served from the domain root or when
# Passenger already detects the sub-folder.
APP_BASE_PATH=/ldt

# Optional: store uploads somewhere else (must be writable)
# LDT_UPLOAD_DIR=/home/USER/ldt_uploads

# Local development only
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=1
